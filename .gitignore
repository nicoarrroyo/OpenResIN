# Based on https://github.com/github/gitignore/blob/main/Python.gitignore
# Sections for tools not used in this project have been removed.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/
docs/

# Environments
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Lock files
#   Lock files pin exact dependency versions and generally SHOULD be committed
#   for an application, so the environment is reproducible. Listed here only as
#   a reminder that this is a deliberate choice, not an oversight.
# uv.lock
# poetry.lock
# Pipfile.lock

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# PyPI configuration file
.pypirc

# Spyder project settings
.spyderproject
.spyproject

# Zed editor
.zed/

# KDevelop project settings
.kdev4/
*.kdev4

# Generated files / directories
.claude
.mcp.json

# User-supplied inputs
#   Contents are ignored, documentation is kept. data/seed-labels/ has no rule
#   here on purpose: the hand-labelled seed CSVs are fixtures and are meant to
#   be tracked. Seed and generated labels are separated by directory, not by
#   filename, so no negation rules are needed to tell them apart.
data/sat-images/*
!data/sat-images/README.md

data/masks/*/*
!data/masks/*/.keep

# Generated artifacts
outputs/*
!outputs/README.md

models/*
!models/README.md
